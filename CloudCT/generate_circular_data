def calculate_delta_omega(R_max, R_earth, R_sat):
    opposite = R_max / 2.0
    adjacent = R_earth + R_sat
    theta = np.arctan(opposite / adjacent)
    return 2.0 * theta

def sample_camera_locations_zenith_varied_v2(N, R_sat, R_earth, delta_omega, safe_dist_km=200):
    camera_locations = []
    R_total = R_earth + R_sat 
    
    # Define a range for Theta (Zenith variety)
    # For example: +/- 5 degrees around the center theta
    theta_center = delta_omega / 2.0
    theta_variation = np.radians(5) 
    theta_min_range = theta_center - theta_variation
    theta_max_range = theta_center #+ theta_variation

    # SAFETY: Use the smallest R_ring (smallest sin(theta)) to calculate buffer
    # This guarantees the 200km gap even at the "tightest" part of the cone
    min_theta_in_sample = min(theta_min_range, theta_max_range)
    R_ring_min = R_total * np.sin(min_theta_in_sample)
    
    phi_safe_total = safe_dist_km / R_ring_min
    phi_buffer = phi_safe_total / 2.0
    bin_width = (2 * np.pi / N)

    if phi_safe_total >= bin_width:
        raise ValueError("Cameras too crowded for safety distance.")

    for i in range(N):
        # 1. Randomized Zenith angle (Theta)
        current_theta = np.random.uniform(theta_min_range, theta_max_range)
        
        # 2. Randomized Azimuth (Phi) within safe bin
        phi_min = (bin_width * i) + phi_buffer
        phi_max = (bin_width * (i + 1)) - phi_buffer
        current_phi = np.random.uniform(phi_min, phi_max)
        
        # 3. Randomized Altitude (Radial distance)
        # Adding +/- 20km variety in orbital height
        current_R = R_total + np.random.uniform(0, 50)

        # 4. Convert Spherical to Cartesian
        x = current_R * np.sin(current_theta) * np.cos(current_phi)
        y = current_R * np.sin(current_theta) * np.sin(current_phi)
        z = current_R * np.cos(current_theta) - R_earth 

        camera_locations.append([x, y, z])
        
    return np.array(camera_locations)

